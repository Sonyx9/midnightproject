---
import Base from '../layouts/Base.astro';
import TrackerOptin from '../components/TrackerOptin.astro';
import OrderDialog from '../components/OrderDialog.astro';
import OrderScript from '../components/OrderScript.astro';
import { products, formatPrice, orderAnchor } from '../data/products';
import { BRAND, CHECKOUT_NOTE } from '../consts';

const title = 'Midnight Project — postav se sám sobě';
const description =
  'Dvě výzvy: sedmidenní dopaminový detox a 75 dní. Denní plán, tracker a parta, co jede s tebou. Kdo to dotáhne, jde na párty.';

const buyables = products.map((product) => ({
  ...product,
  priceLabel: product.priceCzk !== null ? formatPrice(product.priceCzk) : null,
}));

/** Offer emitujeme jen u produktu, který má vyplněnou cenu. */
const offers = buyables
  .filter((p) => p.priceCzk !== null)
  .map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: p.title,
      description: p.tagline,
      brand: { '@type': 'Brand', name: BRAND.name },
      offers: {
        '@type': 'Offer',
        price: p.priceCzk,
        priceCurrency: 'CZK',
        availability: 'https://schema.org/InStock',
        url: `${BRAND.url}/#${orderAnchor(p.slug)}`,
      },
    },
  }));

const productsJsonLd =
  offers.length > 0
    ? { '@context': 'https://schema.org', '@type': 'ItemList', itemListElement: offers }
    : null;

const manifesto = [
  'Žádné motivační kecy — plán, tracker a tvoje hlava',
  'Plán píšeme až z výzvy, kterou máme odjetou',
  'Garance vrácení peněz u všeho, co prodáme',
];
---

<Base title={title} description={description} path="/">
  {
    productsJsonLd && (
      <script
        slot="head"
        type="application/ld+json"
        set:html={JSON.stringify(productsJsonLd)}
        is:inline
      />
    )
  }

  <!-- Hero -->
  <section class="hero">
    <div class="shell">
      <p class="label">// VÝZVA</p>
      <h1>Postav se sám sobě.</h1>
      <p class="hero__lead">
        Sedm dní, nebo sedmdesát pět. Dostaneš plán na každý den, tracker
        a partu, co jede stejnou výzvu s tebou. Zbytek je na tobě.
      </p>
      <p class="hero__cta">
        <a class="btn" href="#vyzvy">Vyber si výzvu →</a>
        <a class="btn btn--ghost" href="#odmena">Co za to</a>
      </p>
    </div>
  </section>

  <hr class="rule" />

  <!-- Produkty -->
  <section class="products shell" aria-labelledby="vyzvy">
    <div class="section-head">
      <p class="label">// VYBER SI VÝZVU</p>
      <h2 id="vyzvy">Dvě výzvy. Obě tě prověří.</h2>
      <p class="section-head__note">
        Víc jich nemáme schválně. Výzvu si nejdřív odjedeme sami — plán píšeme
        až z toho, co je za námi.
      </p>
    </div>

    <ul class="cards">
      {
        buyables.map((product) => (
          <li class="card" id={orderAnchor(product.slug)}>
            {product.badge && <span class="card__badge">{product.badge}</span>}
            <h3 class="card__title">{product.title}</h3>
            <p class="card__tagline">{product.tagline}</p>

            <p class="card__label">Co dostaneš</p>
            <ul class="card__includes">
              {product.includes.map((item) => (
                <li class="check" data-checked="true">
                  <span>{item}</span>
                </li>
              ))}
            </ul>

            <div class="card__buy">
              {product.priceLabel && (
                <p class="card__price">{product.priceLabel}</p>
              )}
              <OrderDialog
                formId={product.simpleShopFormId}
                title={product.title}
              />
              <p class="card__where">{CHECKOUT_NOTE}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <OrderScript />

    <p class="products__guarantee">
      Nesedne ti to? Napiš nám a peníze vrátíme. U všeho, co prodáme.
    </p>
  </section>

  <!-- Odměna -->
  <section class="reward" id="odmena" aria-labelledby="odmena-heading">
    <div class="shell">
      <p class="label">// ODMĚNA</p>
      <h2 id="odmena-heading">Dotáhni to. A jdi na párty.</h2>
      <p class="reward__text">
        Poslední den výzvy není konec, ale důvod. Kdo to dotáhne, slaví
        s ostatními, co si tím prošli taky — a ti se neptají, jestli to bylo
        těžké. Vědí to.
      </p>
      <p class="reward__cta">
        <a class="btn" href="#vyzvy">Jdu do toho →</a>
      </p>
    </div>
  </section>

  <!-- Email capture -->
  <section class="capture shell">
    <TrackerOptin
      id="tracker"
      source="midnight-onepage"
      heading="Ještě váháš? Zkus se nejdřív udržet týden."
      text="Nech email a pošleme ti tracker zdarma. Odškrtávej si dny — uvidíš sám, jestli na výzvu máš."
    />
  </section>

  <!-- Mini-manifest -->
  <section class="manifesto shell" aria-labelledby="manifest">
    <p class="label">// JAK TO DĚLÁME</p>
    <h2 id="manifest" class="visually-hidden">Náš mini-manifest</h2>
    <ul class="manifesto__list">
      {
        manifesto.map((line) => (
          <li class="check" data-checked="true">
            <span>{line}</span>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(3rem, 2rem + 6vw, 6.5rem);
  }

  .hero h1 {
    margin-block: 1.25rem 1.5rem;
  }

  .hero__lead {
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem);
    color: var(--muted);
    max-width: 46ch;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 2.5rem;
  }

  .section-head {
    margin-block-end: 2.5rem;
  }

  .section-head h2 {
    margin-block-start: 0.75rem;
  }

  .section-head__note {
    margin-block-start: 0.85rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .products {
    padding-block: clamp(3rem, 2rem + 4vw, 5rem);
    scroll-margin-block-start: 1.5rem;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: var(--rule-w);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2rem 1.75rem;
    border: var(--rule-w) solid var(--rule);
    scroll-margin-block-start: 1.5rem;
  }

  .card__badge {
    align-self: start;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0.3rem 0.6rem;
    border: 2px solid var(--accent);
    color: var(--accent);
  }

  .card__tagline {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .card__label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .card__includes {
    display: grid;
    gap: 0.75rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .card__includes .check {
    font-size: 0.875rem;
  }

  /* Cena, tlačítko a poznámka drží pohromadě na patě karty. */
  .card__buy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-block-start: auto;
    padding-block-start: 1.5rem;
    border-top: 2px solid color-mix(in srgb, var(--rule) 45%, transparent);
  }

  .card__price {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 600;
  }

  .card__where {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--muted);
    letter-spacing: 0.06em;
  }

  .products__guarantee {
    margin-block-start: 2rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--muted);
  }

  .reward {
    padding-block: clamp(3.5rem, 2.5rem + 5vw, 6rem);
  }

  .reward h2 {
    margin-block-start: 0.75rem;
  }

  .reward__text {
    margin-block-start: 1.25rem;
    color: var(--muted);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.125rem);
  }

  .reward__cta {
    margin-block-start: 2rem;
  }

  .capture {
    padding-block-end: clamp(3rem, 2rem + 4vw, 5rem);
  }

  .manifesto {
    padding-block-end: clamp(3rem, 2rem + 4vw, 5rem);
  }

  .manifesto__list {
    display: grid;
    gap: 1rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
</style>
