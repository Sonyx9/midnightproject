---
/**
 * Obsluha všech objednávkových oken na stránce — jednou, přes delegaci,
 * místo kopie skriptu u každé karty.
 */
---

<script is:inline>
  // Službu SimpleShopu natáhneme jednou pro celou stránku.
  (function (i, s, o, g, r, a, m) {
    i[r] =
      i[r] ||
      function () {
        (i[r].q = i[r].q || []).push(arguments);
      };
    i[r].l = 1 * new Date();
    a = s.createElement(o);
    m = s.getElementsByTagName(o)[0];
    a.async = 1;
    a.src = g;
    m.parentNode.insertBefore(a, m);
  })(
    window,
    document,
    'script',
    'https://form.simpleshop.cz/prj/js/SimpleShopService.js',
    'sss'
  );

  document.addEventListener('click', function (event) {
    var opener = event.target.closest('[data-order-open]');
    if (opener) {
      var dialog = document.getElementById(opener.getAttribute('data-order-open'));
      if (!dialog) return;

      // Formulář stavíme až při prvním otevření — ve skrytém okně si SimpleShop
      // nemá jak změřit výšku. Volání se zařadí do fronty, dokud jejich skript
      // nedoběhne, takže na rychlém kliknutí nezáleží.
      if (!dialog.dataset.built) {
        dialog.dataset.built = '1';
        sss('createForm', dialog.dataset.formId);
      }

      if (typeof dialog.showModal === 'function') {
        dialog.showModal();
      } else {
        dialog.setAttribute('open', '');
      }
      return;
    }

    var closer = event.target.closest('[data-order-close]');
    if (closer) {
      var owner = closer.closest('dialog');
      if (owner) owner.close();
      return;
    }

    // Kliknutí na podklad okna (mimo jeho obsah) taky zavírá.
    if (event.target.matches('dialog.order-dialog')) {
      event.target.close();
    }
  });
</script>
