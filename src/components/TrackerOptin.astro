---
import { ECOMAIL, LINKS } from '../consts';

interface Props {
  heading: string;
  text: string;
  /** Odliší zdroj přihlášení v Ecomailu (kampaň/stránka). */
  source?: string;
  id?: string;
}

const { heading, text, source = 'web', id = 'tracker-optin' } = Astro.props;
const emailId = `${id}-email`;
const consentId = `${id}-consent`;
---

<section class="optin" id={id} aria-labelledby={`${id}-heading`}>
  <h2 id={`${id}-heading`}>{heading}</h2>
  <p class="optin__text">{text}</p>

  <!--
    Ecomail embed. Endpoint a tag se konfigurují v src/consts.ts (ECOMAIL).
    Jde o nativní POST formulář — nic se nedoplňuje JSem, takže nevzniká CLS.
    Wrapper má i tak rezervovanou výšku pro případ pomalého fontu.
  -->
  <div class="optin__form-slot">
    <form class="optin__form" action={ECOMAIL.action} method="post" target="_blank">
      <input type="hidden" name="tags" value={ECOMAIL.tag} />
      <input type="hidden" name="source" value={source} />
      <!-- honeypot proti botům — lidé ho nevyplní -->
      <input
        type="text"
        name="website"
        class="visually-hidden"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      />

      <div class="optin__row">
        <label class="visually-hidden" for={emailId}>Tvůj e-mail</label>
        <input
          id={emailId}
          class="optin__input"
          type="email"
          name="email"
          required
          autocomplete="email"
          inputmode="email"
          placeholder="tvuj@email.cz"
        />
        <button class="btn optin__btn" type="submit">Chci tracker →</button>
      </div>

      <label class="optin__consent" for={consentId}>
        <input id={consentId} type="checkbox" name="consent" value="1" required />
        <span>
          Souhlasím se zpracováním e-mailu za účelem zaslání trackeru a zasílání
          novinek. Odhlásit se můžeš kdykoli jedním klikem. Podrobnosti v
          <a href={LINKS.privacy}>zásadách ochrany osobních údajů</a>.
        </span>
      </label>
    </form>
  </div>
</section>

<style>
  .optin {
    scroll-margin-block-start: 1.5rem;
    border: var(--rule-w) solid var(--rule);
    padding: clamp(1.5rem, 1rem + 2vw, 2.75rem);
  }

  .optin h2 {
    margin-block-end: 0.75rem;
  }

  .optin__text {
    color: var(--muted);
    margin-block-end: 1.75rem;
  }

  /* Rezervovaná výška — formulář nikdy neposune obsah pod sebou. */
  .optin__form-slot {
    min-block-size: 11.5rem;
  }

  .optin__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--rule-w);
    max-width: 34rem;
  }

  .optin__input {
    flex: 1 1 14rem;
    min-inline-size: 0;
    padding: 0.9rem 1rem;
    background: var(--field-bg);
    color: var(--fg);
    border: var(--rule-w) solid var(--rule);
    border-radius: 0;
    font-family: var(--font-mono);
    font-size: 1rem;
    block-size: 3.5rem;
  }

  .optin__input::placeholder {
    color: var(--muted);
  }

  .optin__btn {
    flex: 0 0 auto;
    block-size: 3.5rem;
  }

  .optin__consent {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    align-items: start;
    margin-block-start: 1.25rem;
    max-width: var(--measure);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .optin__consent input {
    inline-size: 1.15rem;
    block-size: 1.15rem;
    margin: 0.15rem 0 0;
    accent-color: var(--accent);
  }

  @media (max-width: 26rem) {
    .optin__btn {
      inline-size: 100%;
    }

    .optin__form-slot {
      min-block-size: 15rem;
    }
  }
</style>
